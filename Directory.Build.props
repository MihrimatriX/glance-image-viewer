<Project>
  <!-- Product name lives here (and in UI resource strings) only. -->
  <PropertyGroup>
    <Product>Glance</Product>
    <Version>0.2.0</Version>
    <Copyright>Glance contributors</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <WindowsTfm>net10.0-windows10.0.19041.0</WindowsTfm>
    <WindowsMinVersion>10.0.17763.0</WindowsMinVersion>
    <!-- Newer C#/WinRT projection: the SDK default (.57) isn't trim-safe. -->
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
  </PropertyGroup>
</Project>
