<Project Sdk="Microsoft.NET.Sdk">
  <!-- Explorer thumbnail handler: a NativeAOT DLL (no .NET runtime to load) hosted in a COM surrogate by the package. -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(WindowsMinVersion)</TargetPlatformMinVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glance.Imaging\Glance.Imaging.csproj" />
  </ItemGroup>
</Project>
