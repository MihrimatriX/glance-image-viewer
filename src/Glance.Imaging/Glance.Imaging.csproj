<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(WindowsMinVersion)</TargetPlatformMinVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32 emits GeneratedComInterface/LibraryImport (ComWrappers) instead of built-in COM: trimming/AOT-safe. -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>
  <ItemGroup>
    <!-- AnyCPU: one managed assembly for all RIDs; RID-specific builds copy only the matching native DLL (ADR 0003). -->
    <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" Version="14.17.2" />
    <!-- Build-time only: generates the WIC COM interop listed in NativeMethods.txt (ADR 0005). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.347" PrivateAssets="all" />
  </ItemGroup>
</Project>
